{
  "manifest_version": 3,
  "name": "WhatsApp Web Çevirici",
  "version": "1.0",
  "description": "WhatsApp Web'deki mesajları istediğiniz dile çeviren kullanışlı bir eklenti",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.whatsapp.com/*",
    "https://translation-api.com/*",
    "https://libretranslate.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
} 